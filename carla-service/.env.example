# Your friend's laptop backend, through Cloudflare Tunnel. No token in this URL.
BACKEND_URL=https://your-tunnel.trycloudflare.com
# Same value as SENDER_TOKEN in the laptop's backend/.env.
SENDER_TOKEN=
VEHICLE_NAME=Friend CARLA
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
# Full AI profile. Command-line flags override these saved settings.
AI_MODE=yolo
AI_DEVICE=auto
AI_FPS=15
RESEARCH_ENABLED=true
VIDEO_DELAY_MS=200
VIDEO_VIEW=compare
DIRECTION_SPEED_LIMIT_KMH=1
RESEARCH_SEED=2026
# Default method shown in the research comparison; change in the dashboard.
PREDICTION=raft
PREDICTION_MS=250
TRAFFIC_CARS=30
TRAFFIC_BICYCLES=5
TRAFFIC_PEDESTRIANS=20
# STUN/TURN addresses and credentials are fetched from the authenticated backend.
# The Python sender constructs aiortc RTCIceServer objects from that configuration.
