HOST=127.0.0.1
PORT=4000
FRONTEND_URL=http://localhost:5173,http://localhost:4000,http://127.0.0.1:5173,http://127.0.0.1:4000
# Required: generate TWO different random tokens, at least 32 characters each.
DASHBOARD_TOKEN=
SENDER_TOKEN=
# Shared with authenticated browser AND Python sender; never put these in VITE_*.
STUN_URL=stun:stun.l.google.com:19302
# External TURN service. Supply all three, or leave all three empty.
# Example address: turn:relay.example.com:3478?transport=udp
# TLS alternative if supported by your provider: turns:relay.example.com:5349?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Explicit local testing only. The normal dashboard has no synthetic fallback.
ALLOW_DEMO=false
